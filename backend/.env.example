# Copia este archivo como backend/.env y completa los valores.
# backend/.env está en .gitignore: NUNCA lo subas al repositorio.

NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incident_hub
DB_USER=postgres
DB_PASSWORD=postgres123
DB_SSL=false

# JWT — usa una cadena aleatoria de 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen permitido por CORS (frontend de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Datos iniciales (npm run seed / npm run seed:demo)
SEED_ADMIN_NOMBRE=Administrador TI
SEED_ADMIN_EMAIL=admin@incidenthub.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=